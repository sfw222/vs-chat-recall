{
  "name": "recall-jump",
  "displayName": "Recall Jump — Copilot Chat History",
  "description": "%extension.description%",
  "version": "1.0.1",
  "publisher": "sfw222",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Other"],
  "keywords": [
    "chat history",
    "copilot chat",
    "session",
    "recall",
    "local",
    "jump"
  ],
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/sfw222/vs-chat-recall.git"
  },
  "homepage": "https://github.com/sfw222/vs-chat-recall#readme",
  "bugs": {
    "url": "https://github.com/sfw222/vs-chat-recall/issues"
  },
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "recall.openSession",
        "title": "%command.openSession.title%"
      },
      {
        "command": "recall.pickDb",
        "title": "%command.pickDb.title%"
      },
      {
        "command": "recall.pickExecutable",
        "title": "%command.pickExecutable.title%"
      },
      {
        "command": "recall.collect",
        "title": "%command.collect.title%"
      },
      {
        "command": "recall.checkSetup",
        "title": "%command.checkSetup.title%"
      }
    ],
    "configuration": {
      "title": "Recall Jump",
      "properties": {
        "recall.executable": {
          "type": "string",
          "default": "",
          "description": "%config.executable.description%"
        },
        "recall.db": {
          "type": "string",
          "default": "",
          "description": "%config.db.description%"
        },
        "recall.pendingFile": {
          "type": "string",
          "default": "",
          "description": "%config.pendingFile.description%"
        }
      }
    }
  }
}
