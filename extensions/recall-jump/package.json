{
  "name": "recall-jump",
  "displayName": "Recall Jump",
  "description": "%extension.description%",
  "version": "0.0.2",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "recall.openSession",
        "title": "%command.openSession.title%"
      }
    ],
    "configuration": {
      "title": "Recall Jump",
      "properties": {
        "recall.executable": {
          "type": "string",
          "default": "",
          "description": "%config.executable.description%"
        },
        "recall.db": {
          "type": "string",
          "default": "",
          "description": "%config.db.description%"
        },
        "recall.pendingFile": {
          "type": "string",
          "default": "",
          "description": "%config.pendingFile.description%"
        }
      }
    }
  }
}
